{
  "name": "boxalarm-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "semver": "^7.5.2"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1136.0",
    "@aws-sdk/client-dynamodb": "3.1136.0",
    "@aws-sdk/client-eventbridge": "3.1136.0",
    "@aws-sdk/client-kms": "3.1136.0",
    "@aws-sdk/client-lambda": "3.1136.0",
    "@aws-sdk/client-s3": "3.1136.0",
    "@aws-sdk/client-scheduler": "^3.1136.0",
    "@aws-sdk/client-secrets-manager": "3.1136.0",
    "@aws-sdk/client-sesv2": "3.1136.0",
    "@aws-sdk/client-sns": "3.1136.0",
    "@aws-sdk/client-ssm": "3.1136.0",
    "@aws-sdk/client-verifiedpermissions": "3.1136.0",
    "@aws-sdk/lib-dynamodb": "3.1136.0",
    "@aws-sdk/s3-request-presigner": "3.1136.0",
    "@aws-sdk/util-dynamodb": "3.996.9",
    "@boxalarm/authz": "*",
    "@boxalarm/dept-scope": "*",
    "@boxalarm/health": "*",
    "@boxalarm/logging": "*",
    "@boxalarm/metrics": "*",
    "@boxalarm/outbox": "*",
    "aws-jwt-verify": "5.2.1",
    "aws-xray-sdk-core": "3.12.0",
    "ngeohash": "0.6.4",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testcontainers/localstack": "12.1.0",
    "@types/aws-lambda": "8.10.163",
    "@types/ngeohash": "0.6.8",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "3.2.7",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.8",
    "testcontainers": "12.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "3.2.7"
  }
}
